<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar</PackageId>
    <Version>1.0.14</Version>
    <AssemblyVersion>1.0.14.0</AssemblyVersion>
    <FileVersion>1.0.14.0</FileVersion>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Product>CronRadar .NET SDK</Product>
    <Description>Non-blocking lifecycle and heartbeat monitoring for .NET scheduled jobs, with missed-run, failure, and stuck-run detection.</Description>
    <Copyright>Copyright © CronRadar 2026</Copyright>
    <PackageProjectUrl>https://cronradar.com/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-dotnet</RepositoryUrl>
    <PackageTags>cronradar;dotnet;scheduled-jobs;cron;monitoring;missed-jobs;failed-jobs;stuck-jobs;heartbeat</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Clarifies scheduled-job reliability coverage and package discovery metadata; runtime behavior is unchanged.</PackageReleaseNotes>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Minimal dependency for JSON serialization -->
  <ItemGroup>
    <!-- System.Text.Json for sync endpoint - only needed for older frameworks -->
    <PackageReference Include="System.Text.Json" Version="4.7.2" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- System.Text.Json 4.7.2 allows System.Text.Encodings.Web 4.7.1 (GHSA-ghhp-997w-qr28); 4.7.2 is the patched floor -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.7.2" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- .NET 6+ includes System.Text.Json in the framework -->
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
