<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar</PackageId>
    <Version>0.0.1</Version>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <Product>CronRadar .NET SDK</Product>
    <Description>Dead-simple cron job monitoring. One function: Ping(). Zero dependencies.</Description>
    <Copyright>Copyright © CronRadar 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cronradar/cronradar-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-dotnet</RepositoryUrl>
    <PackageTags>cron;monitoring;scheduler;job;task;ping</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
v0.0.1 - Fresh Start: Minimal by Design
• One function: Ping()
• Zero dependencies
• 30 lines of code
• Never throws exceptions
• Static class for simplicity
• Framework extensions available separately
    </PackageReleaseNotes>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NO DEPENDENCIES - This is the core principle -->

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>