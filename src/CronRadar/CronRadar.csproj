<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Package Information -->
    <PackageId>CronRadar</PackageId>
    <Version>0.0.3</Version>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <Product>CronRadar .NET SDK</Product>
    <Description>Dead-simple cron job monitoring with auto-registration. Two functions: Ping() and SyncMonitor(). Self-healing monitors.</Description>
    <Copyright>Copyright © CronRadar 2025</Copyright>
    <PackageProjectUrl>https://github.com/cronradar/cronradar-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-dotnet</RepositoryUrl>
    <PackageTags>cron;monitoring;scheduler;job;task;ping;sync;auto-register</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Monitor any scheduled job with self-healing. Just call CronRadar.Ping() after your job completes.</PackageReleaseNotes>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Minimal dependency for JSON serialization -->
  <ItemGroup>
    <!-- System.Text.Json for sync endpoint - only needed for older frameworks -->
    <PackageReference Include="System.Text.Json" Version="4.7.2" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <!-- .NET 6+ includes System.Text.Json in the framework -->
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>