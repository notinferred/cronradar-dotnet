<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Package Information -->
    <PackageId>CronRadar</PackageId>
    <Version>1.0.6</Version>
    <Authors>CronRadar</Authors>
    <Company>CronRadar</Company>
    <Product>CronRadar .NET SDK</Product>
    <Title>CronRadar - One-Line Cron Job Monitoring</Title>
    <Description>Official .NET SDK for CronRadar. Monitor Hangfire, Quartz.NET, and BackgroundService jobs with one line of code. Features automatic job discovery, zero-config setup, and fail-safe operation.</Description>
    <PackageTags>cronradar;monitoring;cron;scheduled-tasks;background-jobs;hangfire;quartz;health-monitoring;alerting;devops</PackageTags>
    <PackageProjectUrl>https://cronradar.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cronradar/cronradar-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
v1.0.6 - Production Ready
• IMPROVED: Automatic job discovery with multiple retry attempts
• FIXED: JobStorage.Current availability issues
• CLEANED: Removed debug console output for production use
• STABLE: Monitors reliably sync on application startup
    </PackageReleaseNotes>

    <!-- Build Configuration -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Strong Naming -->
    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile>CronRadar.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <!-- Core dependencies - using built-in .NET libraries only -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>

  <!-- Optional dependencies for DI support -->
  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.20" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <!-- Development dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- Package assets -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Conditional compilation for framework features -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net7.0' OR '$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);NET6_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

</Project>